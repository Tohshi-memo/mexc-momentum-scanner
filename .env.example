# ============================================================
# MEXC API Credentials (Read-only recommended for dry run)
# ============================================================
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_key_here

# ============================================================
# Scanner Settings
# ============================================================
# BTC 1h return threshold to judge "bearish or stagnant" (%)
BTC_BEARISH_THRESHOLD=-0.5
BTC_STAGNANT_THRESHOLD=0.2

# Minimum 1h return for an alt coin to be flagged (%)
ALT_SURGE_THRESHOLD=5.0

# Minimum 24h quote volume to include a symbol (USDT)
MIN_24H_VOLUME_USDT=1000000

# Scan interval in seconds
SCAN_INTERVAL_SECONDS=300

# ============================================================
# Analyzer Settings
# ============================================================
RSI_PERIOD=14
RSI_OVERBOUGHT=75
BB_PERIOD=20
BB_STD=2.0

# OHLCV timeframe for analysis
ANALYSIS_TIMEFRAME=1h
# Number of candles to fetch per symbol
OHLCV_LIMIT=100

# ============================================================
# Executor Settings
# ============================================================
# DRY_RUN=true → log only, DRY_RUN=false → live order (future)
DRY_RUN=true

# Risk settings (% of account balance / position)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/scanner.log
