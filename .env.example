# ============================================================
# MEXC API Credentials (scanner / local DryRun専用、Read-only必須)
# ============================================================
# Futures Trade権限付きの本番キーをここへ保存しない。
# GitHub本番キーはlive-trading Environment内だけに
# MEXC_LIVE_API_KEY / MEXC_LIVE_SECRET_KEYとして保存し、live workflowが
# 実行時のみ下記runtime名へ割り当てる。
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_key_here

# ============================================================
# Sakura trading-data gateway (all runtime data stays private)
# ============================================================
# URLとsecretが両方空ならsyncは安全にno-op。TD_REPOはserver側の
# HMAC key scopeとevent idempotency namespaceに使う。
TD_BASE_URL=https://leatherwallet.sakura.ne.jp/trading-ingest
TD_REPO=mexc-momentum-scanner
TD_HMAC_SECRET=
TD_BATCH_SIZE=100
TD_OUTBOX_FILE=logs/trading-data-events.jsonl

# ============================================================
# Scanner Settings
# ============================================================
# BTC regime thresholds (used for market regime labeling only)
#   BEARISH  if 1h change <= BTC_BEARISH_THRESHOLD
#   STAGNANT if |1h change| <= BTC_STAGNANT_THRESHOLD
#   BULLISH  otherwise
# Scans now run in ALL regimes. Decoupled alts are detected via
# RELATIVE_STRENGTH_THRESHOLD below.
BTC_BEARISH_THRESHOLD=-0.5
BTC_STAGNANT_THRESHOLD=0.2

# Minimum 1h return for an alt coin to be flagged (%)
ALT_SURGE_THRESHOLD=5.0

# Relative strength threshold vs BTC: (alt_1h - btc_1h) must be ≥ this value (%)
# BTC が上がっている局面でも「他と乖離した独歩高」を検出するための閾値。
#   BEARISH 局面 (BTC -1%): 5% surge → 相対強度 6% で自然に通過
#   BULLISH 局面 (BTC +2%): 5% surge → 相対強度 3% で除外 (乖離不十分)
#                           8% surge → 相対強度 6% で検出 (乖離した独歩高)
RELATIVE_STRENGTH_THRESHOLD=5.0

# Minimum 24h quote volume to include a symbol (USDT)
MIN_24H_VOLUME_USDT=1000000

# Max number of symbols to fetch 1h OHLCV for (top N by 24h change)
# Higher = more thorough but slower. 50 takes ~15s with rate limit.
MAX_OHLCV_CHECKS=50

# Scan interval in seconds
SCAN_INTERVAL_SECONDS=300

# ============================================================
# Analyzer Settings (Technical)
# ============================================================
RSI_PERIOD=14
RSI_OVERBOUGHT=70
BB_PERIOD=20
BB_STD=2.0

# OHLCV timeframe for analysis
ANALYSIS_TIMEFRAME=1h
# Number of candles to fetch per symbol
OHLCV_LIMIT=100

# ============================================================
# STRICT v2 Filter (is_confirmed_signal) — 2026-04 データ駆動で見直し
# ============================================================
# 唯一のゲート条件は『4h RSI < RSI_4H_MAX』(= 未過熱の新鮮な急騰)。
# シャドウ集計: n=193 exp +0.94% WR 38.3%。全期間ベースライン -0.18% を大きく上回る。
#
# 旧 STRICT v1 (RSI≥70 & 4h≥65 & ¬RISING) はデータで無効と判明したため撤廃。
# RSI(1h) / BB break / Volume NOT RISING は confirmed ゲートから外し、
# tier 判定とブロックゾーンは core/live_filter.py に委譲する。
RSI_4H_MAX=65
USE_4H_FILTER=true

# 出来高トレンド (live_filter Tier S 判定と表示に使用)
# RISING (×1.8 以上) が Tier S 昇格条件 — 4h<65 と combined で exp +2.46% (n=32)
VOLUME_LOOKBACK=20
VOLUME_RISING_RATIO=1.8
VOLUME_DECLINING_RATIO=0.8

# ATR ベース SL (ボラティリティに応じて SL 幅を自動調整)
# sl_pct = clamp(ATR% × ATR_SL_MULT, ATR_SL_MIN, ATR_SL_MAX)
ATR_PERIOD=14
USE_ATR_SL=true
ATR_SL_MULT=1.5
ATR_SL_MIN=1.0
ATR_SL_MAX=4.0

# リスクリワード比: TP幅 = sl_pct × RISK_REWARD_RATIO
# 2.0 なら勝率 33% で損益分岐。損失許容度を下げるほど RR を大きく。
RISK_REWARD_RATIO=2.0

# Cooldown: この時間内に SL 食らった銘柄は再エントリー禁止
COOLDOWN_HOURS=48

# サーキットブレーカー: 損失件数とコスト控除後損益を組み合わせて段階判定
CIRCUIT_BREAKER_WINDOW=10
CIRCUIT_BREAKER_MIN_SAMPLES=5
CIRCUIT_BREAKER_WARN_LOSSES=5
CIRCUIT_BREAKER_LOSSES=7
CIRCUIT_BREAKER_COST_PCT=0.51
CIRCUIT_BREAKER_SEVERE_NET_LOSS_PCT=-8.0
# CIRCUIT_BREAKER_LOOKBACK_HOURS: 直近 N 時間内に closed した記録のみ対象。
# 0 で無効化 (全期間カウント)。これにより、過去の連敗が延々とブレーカーを
# 発動し続ける問題を防ぐ。新規トレードが途絶えれば自然に pool が空になり
# 自動解除される (= reset_circuit_breaker 不要)。
CIRCUIT_BREAKER_LOOKBACK_HOURS=48

# ============================================================
# Executor Settings
# ============================================================
# DRY_RUN=true → log only. DRY_RUN=false だけでは本番注文は許可されない。
DRY_RUN=true
# true の場合は1サイクルで終了。保護されたlive workflowではtrue固定。
RUN_ONCE=false
# 本番用の二重ロック。ローカル.envでは解除せず、protected live workflowの
# workflow_dispatch入力から毎回設定する。
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=

# 固定 SL/TP (USE_ATR_SL=false の場合のフォールバック)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# ============================================================
# Notifications (Discord + Telegram)
# ============================================================
# Discord チャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック
# 未設定の場合は通知をスキップ（動作には影響なし）
DISCORD_WEBHOOK_URL=
# Telegram Bot API. Store real values in GitHub Secrets, not in this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# Price Tracking
# ============================================================
# 検出銘柄を何時間追跡するか
TRACKING_HOURS=24

# ============================================================
# Filter Granularity Experiment (シャドウトレード)
# ============================================================
# 現行 STRICT フィルターを通った/外れた問わず、全候補を仮想エントリーとして
# 追跡する。data/experiments.json に蓄積され、tools/analyze_experiments.py が
# data/experiment_report.md を生成する。実トレードには影響しない。
#
# シャドウトレードの追跡時間 (短いほど早く outcome 確定 → 早く統計が貯まる)
EXPERIMENT_TRACKING_HOURS=8
# 1サイクルで新規登録するシャドウトレードの上限 (ファイル肥大化抑制)
EXPERIMENT_MAX_PER_CYCLE=20
# ホット experiments.json に保持する closed 件数。超過分は古い方から
# data/archive/experiments_YYYY-MM.json.gz に gzip で移される (分析時は
# tools/analyze_experiments.py が両方を結合して読むので精度影響なし)。
EXPERIMENT_HOT_MAX=500
# main.py で data/experiment_report.md を毎回再生成するか。GitHub Actions の
# scanner.yml では false にし、重い全履歴分析は analysis.yml 側で行う。
GENERATE_EXPERIMENT_REPORT=true

# ============================================================
# Market Context Measurement (軽量な検出前コンテキスト)
# ============================================================
# 全銘柄のOHLCVを保存せず、スキャン母集団の件数・上位銘柄・惜しくも落ちた候補・
# 分析後のreject理由だけを data/market_context.json にローリング保存する。
MARKET_CONTEXT_ENABLED=true
# 5分ごと実行なら 288 件で約24時間分。GitHubに置きやすいようホットデータだけ保持。
MARKET_CONTEXT_MAX_RECORDS=288
MARKET_CONTEXT_TOP_SYMBOLS=20
MARKET_CONTEXT_NEAR_MISS_LIMIT=30
MARKET_CONTEXT_ANALYSIS_SYMBOL_LIMIT=25

# ============================================================
# Fundamental Analysis (無料RSS + Reddit, APIキー不要)
# ============================================================
# CryptoPanic は有料化のため廃止。
# CoinDesk / CoinTelegraph / Decrypt / BeInCrypto の RSS と
# Reddit (r/CryptoCurrency, r/CryptoMoonShots) を無料で使用。

# ニュース検索の遡及時間 (時間)
FUNDAMENTAL_LOOKBACK_HOURS=48

# Reddit 検索を有効にするか (true/false)
USE_REDDIT_NEWS=true

# ============================================================
# Live Trading Filter / Strategy (core/live_filter.py & live_strategy.py)
# ============================================================
# シャドウ集計 (data/experiment_report.md) をもとに実トレードに昇格させる
# Tier S/A/B 判定とポジションサイズを決定する。DRY_RUN=true 中は
# LiveTradePlan を構築するだけで注文は発行されない。
#
# 本番の正本は .github/workflows/live-trade.yml。workflow_dispatch の二重lock、
# default branch、不変commit SHA、live-trading Environment手動承認、unit tests、
# read-only preflightを通過した場合だけmain.pyが実行される。

# ─ Live policy identity / OOS population ─
# stableな非secret口座namespace。signal candle等と組み合わせて注文intentを識別する。
LIVE_ACCOUNT_ID=mexc-primary
# 判定ロジックまたは閾値を変えたらversionを更新する。コードとpolicy ENVから作る
# fingerprintも一致したclosed履歴だけが本番ゲートの母集団になる。
LIVE_POLICY_VERSION=live-v1-20260729
LIVE_POLICY_EFFECTIVE_AT=2026-07-29T00:00:00+00:00
LIVE_REQUIRE_POLICY_VERSION=true

# ─ Fail-closed live performance gate ─
# 現在の保存履歴は新policyと一致するeligible=0のため、当面REJECTが正常。
# 同一policyで200 closed件・30 UTC日以上を新規蓄積し、全窓を通す必要がある。
LIVE_USE_RANKER=true
LIVE_GATE_WINDOWS=20,50,100,200
# 1往復分の手数料想定。
LIVE_GATE_FEE_PCT=0.16
# entry上限0.10% + exit reserve 0.10%。
LIVE_GATE_SLIPPAGE_PCT=0.20
# 24h保有中に最大3回 × 0.05%のfundingを支払う想定。
LIVE_GATE_FUNDING_PCT=0.15
LIVE_GATE_MIN_NET_EV_PCT=0.20
LIVE_GATE_MIN_FILLED=20
LIVE_GATE_MIN_FILL_RATE=0.80
LIVE_GATE_MAX_DATA_AGE_HOURS=24
LIVE_GATE_MIN_DISTINCT_DAYS=30
# 日次clusterのlower95はこの値を超える必要がある。
LIVE_GATE_MIN_CI_PCT=0.0

# ─ Tier gating (全 Tier 共通の前提) ─
# LIVE_RSI_MIN: RSI(1h) の下限。データで効果なしと判明したため実質無効化 (0)。
#               70 に戻すと機会損失が増え、期待値は改善しない (exp -0.35% @ RSI≥70)。
LIVE_RSI_MIN=0
LIVE_RSI_4H_MAX=65
# LIVE_ATR_HIGH: Tier A 昇格の ATR% 閾値。n を増やすため 11→9 に緩和。
#                ATR 9–11%: exp +0.16% (n=127) / ATR ≥11%: exp +0.07% (n=112)
LIVE_ATR_HIGH=9.0
LIVE_REL_STRENGTH_MIN=5.0
# 欠損・非有限のテクニカル、古いsignal candle、欠損/過度に負のfunding、
# 許可外fundamental convictionはすべてREJECT。
LIVE_REQUIRE_COMPLETE_TECHNICAL_DATA=true
LIVE_SIGNAL_MAX_AGE_HOURS=3.0
LIVE_REQUIRE_FUNDING_DATA=true
LIVE_MIN_FUNDING_RATE_PCT=-0.05
LIVE_REQUIRE_FUND_NON_AVOID=true
LIVE_ALLOWED_FUNDAMENTAL_CONVICTIONS=HIGH,MEDIUM

# ─ Block (強制却下) ─ 統計的に劣るゾーン
BLOCK_CONSEC_GREEN_1H=8
BLOCK_BBW_LO=15.0
BLOCK_BBW_HI=20.0
BLOCK_MA_DEV_LO=5.0
BLOCK_MA_DEV_HI=10.0
BLOCK_ATR_LO=5.0
BLOCK_ATR_HI=7.0
BLOCK_WICK_RATIO=0.6
# 最新のforward集計では上ヒゲ単独blockを採用しない。
LIVE_BLOCK_UPPER_WICK=false

# ─ Booster (加点のみ、却下には使わない) ─
BOOST_FUNDING_RATE=0.10
LIVE_BOOST_MULT=0.0

# ─ Strategy ranker ─
# 上の全窓gate通過後も、実装可能なMARKET戦略のgross ranker条件を要求する。
LIVE_MIN_EV_PCT=0.20
LIVE_MIN_RANKER_FILLED=10
# 現在の executor は SHORT MARKET のみ実行可能。LONG/LIMIT/ASK はシャドウで測る。
LIVE_SHORT_ONLY=true

# ─ Risk sizing ─
# 1positionあたり口座残高の最大0.10%。小口約定のために引き上げない。
LIVE_BASE_RISK_PCT=0.10
LIVE_MAX_RISK_PCT=0.10
LIVE_MAX_LEVERAGE=2.0
LIVE_TIER_MULT_S=1.50
LIVE_TIER_MULT_A=1.20
LIVE_TIER_MULT_B=0.80

# ─ Live executor safety / exchange reconciliation ─
LIVE_MAX_ORDERS_PER_RUN=1
LIVE_MAX_NEW_ENTRIES_PER_UTC_DAY=1
LIVE_MIN_BALANCE_USDT=5.0
LIVE_MAX_OPEN_POSITIONS=1
LIVE_MARGIN_MODE=isolated
LIVE_POSITION_MODE=hedged
# isolated=1。未指定時もLIVE_MARGIN_MODEから同じ値を導出する。
LIVE_OPEN_TYPE=1
LIVE_ORDER_VERIFY_ATTEMPTS=5
LIVE_ORDER_VERIFY_DELAY_SECONDS=1.0
LIVE_SYMBOL_REENTRY_COOLDOWN_HOURS=48

# mutating注文の直前にfresh L2、drift、spread、slippage、depthを検証する。
LIVE_MARKET_DATA_MAX_AGE_SECONDS=10
LIVE_MAX_ENTRY_DRIFT_PCT=0.50
LIVE_MAX_SPREAD_PCT=0.10
LIVE_MAX_SLIPPAGE_PCT=0.10
LIVE_MIN_DEPTH_MULTIPLE=1.0
# 約定後に実価格/数量/SLから再計算したriskを計画値の1.05倍以内に制限。
LIVE_MAX_ACTUAL_RISK_MULTIPLIER=1.05

# confirmed fill/protectionだけをrunner-local JSONLへ追記。workflowがlogs/を
# artifact保存するが、source of truthはMEXCでありledgerは再実行間のlockではない。
LIVE_EXECUTION_LEDGER_FILE=logs/live-executions.jsonl

# ─ Entry styling ─
LIVE_LIMIT_OFFSET_PCT=7.0
LIVE_PATIENT_OFFSET_PCT=6.0
LIVE_SCALE_MARKET_WEIGHT=0.4

# ─ Direction bias (experiment_report セクション22 の short_edge%) ─
LIVE_LONG_BIAS_PCT=60.0
LIVE_SHORT_BIAS_PCT=40.0

# ─ Trailing / partial TP ─
LIVE_MOVE_BE_AT_RR=1.0
LIVE_PARTIAL_TP_RR=1.0
LIVE_PARTIAL_TP_RATIO=0.5

# ─ Live virtual portfolio (core/live_portfolio.py) ─
# ライブ戦略の仮想残高を $100 ベースで追跡。data/live_portfolio.json に保存。
LIVE_VIRTUAL_CAPITAL=100

# ─ Safe adaptive DryRun portfolio (core/safe_adaptive_portfolio.py) ─
# 既存 live_portfolio とは別に、新しい $100 口座で動的戦略切替をフォワードテストする。
# 実注文は出さず、closed shadow experiment の entry_variants だけを使って検証する。
SAFE_ADAPTIVE_ENABLED=true
SAFE_ADAPTIVE_CAPITAL=100
SAFE_ADAPTIVE_RISK_PCT=0.5
SAFE_ADAPTIVE_RECENT_N=50
SAFE_ADAPTIVE_MIN_RECENT_FILLED=10
SAFE_ADAPTIVE_MIN_ALL_FILLED=30
SAFE_ADAPTIVE_MIN_EV_PCT=0.20
SAFE_ADAPTIVE_MIN_AVG_LOG_RETURN=0.0
SAFE_ADAPTIVE_MAX_STRATEGY_DD_PCT=15
SAFE_ADAPTIVE_MAX_PORTFOLIO_DD_PCT=10
SAFE_ADAPTIVE_DAILY_LOSS_STOP_PCT=2
SAFE_ADAPTIVE_MAX_LOSS_STREAK=6
SAFE_ADAPTIVE_LOSS_STREAK_COOLDOWN_HOURS=6
SAFE_ADAPTIVE_ALLOW_LONG=true
SAFE_ADAPTIVE_ALLOW_SHORT=true
SAFE_ADAPTIVE_ALLOW_LIMIT=true

# ─ Robust adaptive DryRun portfolio (core/robust_adaptive_portfolio.py) ─
# Safe Adaptive の横で、コスト・中期安定性・DDをより厳しく見る改善版。
ROBUST_ADAPTIVE_ENABLED=true
ROBUST_ADAPTIVE_CAPITAL=100
ROBUST_ADAPTIVE_RISK_PCT=0.35
ROBUST_ADAPTIVE_COST_PCT=0.15
ROBUST_ADAPTIVE_RECENT_N=50
ROBUST_ADAPTIVE_MID_N=200
ROBUST_ADAPTIVE_MIN_RECENT_FILLED=12
ROBUST_ADAPTIVE_MIN_MID_FILLED=30
ROBUST_ADAPTIVE_MIN_ALL_FILLED=50
ROBUST_ADAPTIVE_MIN_RECENT_FILL_RATE=0.25
ROBUST_ADAPTIVE_MIN_EV_PCT=0.20
ROBUST_ADAPTIVE_MIN_AVG_LOG_RETURN=0.0
ROBUST_ADAPTIVE_MAX_STRATEGY_DD_PCT=8
ROBUST_ADAPTIVE_MAX_ALL_STRATEGY_DD_PCT=20
ROBUST_ADAPTIVE_MAX_PORTFOLIO_DD_PCT=8
ROBUST_ADAPTIVE_DAILY_LOSS_STOP_PCT=1.5
ROBUST_ADAPTIVE_MAX_LOSS_STREAK=5
ROBUST_ADAPTIVE_LOSS_STREAK_COOLDOWN_HOURS=12
ROBUST_ADAPTIVE_ALLOW_LONG=true
ROBUST_ADAPTIVE_ALLOW_SHORT=true
ROBUST_ADAPTIVE_ALLOW_LIMIT=true

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/scanner.log
