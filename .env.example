# ============================================================
# MEXC API Credentials (Read-only recommended for dry run)
# ============================================================
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_key_here

# ============================================================
# Scanner Settings
# ============================================================
# BTC 1h return threshold to judge "bearish or stagnant" (%)
BTC_BEARISH_THRESHOLD=-0.5
BTC_STAGNANT_THRESHOLD=0.2

# Minimum 1h return for an alt coin to be flagged (%)
ALT_SURGE_THRESHOLD=5.0

# Minimum 24h quote volume to include a symbol (USDT)
MIN_24H_VOLUME_USDT=1000000

# Max number of symbols to fetch 1h OHLCV for (top N by 24h change)
# Higher = more thorough but slower. 50 takes ~15s with rate limit.
MAX_OHLCV_CHECKS=50

# Scan interval in seconds
SCAN_INTERVAL_SECONDS=300

# ============================================================
# Analyzer Settings
# ============================================================
RSI_PERIOD=14
RSI_OVERBOUGHT=75
BB_PERIOD=20
BB_STD=2.0

# OHLCV timeframe for analysis
ANALYSIS_TIMEFRAME=1h
# Number of candles to fetch per symbol
OHLCV_LIMIT=100

# ============================================================
# Executor Settings
# ============================================================
# DRY_RUN=true → log only, DRY_RUN=false → live order (future)
DRY_RUN=true

# Risk settings (% of account balance / position)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# ============================================================
# Notifications (Discord Webhook)
# ============================================================
# Discord チャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック
# 未設定の場合は通知をスキップ（動作には影響なし）
DISCORD_WEBHOOK_URL=

# ============================================================
# Price Tracking
# ============================================================
# 検出銘柄を何時間追跡するか
TRACKING_HOURS=24

# ============================================================
# Fundamental Analysis (CryptoPanic)
# ============================================================
# 無料APIキー取得: https://cryptopanic.com/developers/api/
# 未設定の場合はファンダ考察をスキップ (conviction=MEDIUM でフォールスルー)
CRYPTOPANIC_API_KEY=

# ニュース検索の遡及時間 (時間)
FUNDAMENTAL_LOOKBACK_HOURS=48

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/scanner.log
