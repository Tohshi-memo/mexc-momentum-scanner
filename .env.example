# ============================================================
# MEXC API Credentials (Read-only recommended for dry run)
# ============================================================
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_key_here

# ============================================================
# Scanner Settings
# ============================================================
# BTC 1h return threshold to judge "bearish or stagnant" (%)
BTC_BEARISH_THRESHOLD=-0.5
BTC_STAGNANT_THRESHOLD=0.2

# Minimum 1h return for an alt coin to be flagged (%)
ALT_SURGE_THRESHOLD=5.0

# Minimum 24h quote volume to include a symbol (USDT)
MIN_24H_VOLUME_USDT=1000000

# Max number of symbols to fetch 1h OHLCV for (top N by 24h change)
# Higher = more thorough but slower. 50 takes ~15s with rate limit.
MAX_OHLCV_CHECKS=50

# Scan interval in seconds
SCAN_INTERVAL_SECONDS=300

# ============================================================
# Analyzer Settings (Technical)
# ============================================================
RSI_PERIOD=14
RSI_OVERBOUGHT=75
BB_PERIOD=20
BB_STD=2.0

# OHLCV timeframe for analysis
ANALYSIS_TIMEFRAME=1h
# Number of candles to fetch per symbol
OHLCV_LIMIT=100

# ============================================================
# Loss Reduction Filters (損失低減フィルター)
# ============================================================
# Multi-timeframe: 4h RSI がこの値以上なら既存トレンド扱いで見送り
# 低いほど厳しい。既存トレンド由来の負けを減らす。
RSI_4H_MAX=70
USE_4H_FILTER=true

# 出来高トレンド: 直近1足の出来高 / 過去20足平均
# 比率が RISING 以上  → トレンド継続 → 見送り
# 比率が DECLINING 以下 → 疲弊 → ショート可
VOLUME_LOOKBACK=20
VOLUME_RISING_RATIO=1.8
VOLUME_DECLINING_RATIO=0.8
USE_VOLUME_FILTER=true

# ATR ベース SL (ボラティリティに応じて SL 幅を自動調整)
# sl_pct = clamp(ATR% × ATR_SL_MULT, ATR_SL_MIN, ATR_SL_MAX)
ATR_PERIOD=14
USE_ATR_SL=true
ATR_SL_MULT=1.5
ATR_SL_MIN=1.0
ATR_SL_MAX=4.0

# リスクリワード比: TP幅 = sl_pct × RISK_REWARD_RATIO
# 2.0 なら勝率 33% で損益分岐。損失許容度を下げるほど RR を大きく。
RISK_REWARD_RATIO=2.0

# Cooldown: この時間内に SL 食らった銘柄は再エントリー禁止
COOLDOWN_HOURS=48

# サーキットブレーカー: 直近 WINDOW 件中 LOSSES 件以上 SL なら当サイクル全スキップ
CIRCUIT_BREAKER_WINDOW=10
CIRCUIT_BREAKER_LOSSES=5

# ============================================================
# Executor Settings
# ============================================================
# DRY_RUN=true → log only, DRY_RUN=false → live order (future)
DRY_RUN=true

# 固定 SL/TP (USE_ATR_SL=false の場合のフォールバック)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# ============================================================
# Notifications (Discord Webhook)
# ============================================================
# Discord チャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック
# 未設定の場合は通知をスキップ（動作には影響なし）
DISCORD_WEBHOOK_URL=

# ============================================================
# Price Tracking
# ============================================================
# 検出銘柄を何時間追跡するか
TRACKING_HOURS=24

# ============================================================
# Fundamental Analysis (無料RSS + Reddit, APIキー不要)
# ============================================================
# CryptoPanic は有料化のため廃止。
# CoinDesk / CoinTelegraph / Decrypt / BeInCrypto の RSS と
# Reddit (r/CryptoCurrency, r/CryptoMoonShots) を無料で使用。

# ニュース検索の遡及時間 (時間)
FUNDAMENTAL_LOOKBACK_HOURS=48

# Reddit 検索を有効にするか (true/false)
USE_REDDIT_NEWS=true

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/scanner.log
