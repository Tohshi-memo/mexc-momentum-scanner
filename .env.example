# ============================================================
# MEXC API Credentials (Read-only recommended for dry run)
# ============================================================
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_key_here

# ============================================================
# Scanner Settings
# ============================================================
# BTC regime thresholds (used for market regime labeling only)
#   BEARISH  if 1h change <= BTC_BEARISH_THRESHOLD
#   STAGNANT if |1h change| <= BTC_STAGNANT_THRESHOLD
#   BULLISH  otherwise
# Scans now run in ALL regimes. Decoupled alts are detected via
# RELATIVE_STRENGTH_THRESHOLD below.
BTC_BEARISH_THRESHOLD=-0.5
BTC_STAGNANT_THRESHOLD=0.2

# Minimum 1h return for an alt coin to be flagged (%)
ALT_SURGE_THRESHOLD=5.0

# Relative strength threshold vs BTC: (alt_1h - btc_1h) must be ≥ this value (%)
# BTC が上がっている局面でも「他と乖離した独歩高」を検出するための閾値。
#   BEARISH 局面 (BTC -1%): 5% surge → 相対強度 6% で自然に通過
#   BULLISH 局面 (BTC +2%): 5% surge → 相対強度 3% で除外 (乖離不十分)
#                           8% surge → 相対強度 6% で検出 (乖離した独歩高)
RELATIVE_STRENGTH_THRESHOLD=5.0

# Minimum 24h quote volume to include a symbol (USDT)
MIN_24H_VOLUME_USDT=1000000

# Max number of symbols to fetch 1h OHLCV for (top N by 24h change)
# Higher = more thorough but slower. 50 takes ~15s with rate limit.
MAX_OHLCV_CHECKS=50

# Scan interval in seconds
SCAN_INTERVAL_SECONDS=300

# ============================================================
# Analyzer Settings (Technical)
# ============================================================
RSI_PERIOD=14
RSI_OVERBOUGHT=70
BB_PERIOD=20
BB_STD=2.0

# OHLCV timeframe for analysis
ANALYSIS_TIMEFRAME=1h
# Number of candles to fetch per symbol
OHLCV_LIMIT=100

# ============================================================
# Loss Reduction Filters (損失低減フィルター)
# ============================================================
# Multi-timeframe: 4h RSI がこの値以上ならダブルオーバーボートでエントリー対象。
# データ分析の結果、4h RSI が高いほどショートの勝率・期待値が向上する。
# 旧フィルター (RSI_4H_MAX=70 で上限を設けて除外) は逆効果だった。
RSI_4H_MIN=65
USE_4H_FILTER=true

# 出来高トレンド: 直近1足の出来高 / 過去20足平均
# 比率が RISING 以上  → トレンド継続 → 見送り
# 比率が DECLINING 以下 → 疲弊 → ショート可
VOLUME_LOOKBACK=20
VOLUME_RISING_RATIO=1.8
VOLUME_DECLINING_RATIO=0.8
USE_VOLUME_FILTER=true

# ATR ベース SL (ボラティリティに応じて SL 幅を自動調整)
# sl_pct = clamp(ATR% × ATR_SL_MULT, ATR_SL_MIN, ATR_SL_MAX)
ATR_PERIOD=14
USE_ATR_SL=true
ATR_SL_MULT=1.5
ATR_SL_MIN=1.0
ATR_SL_MAX=4.0

# リスクリワード比: TP幅 = sl_pct × RISK_REWARD_RATIO
# 2.0 なら勝率 33% で損益分岐。損失許容度を下げるほど RR を大きく。
RISK_REWARD_RATIO=2.0

# Cooldown: この時間内に SL 食らった銘柄は再エントリー禁止
COOLDOWN_HOURS=48

# サーキットブレーカー: 直近 WINDOW 件中 LOSSES 件以上 SL なら当サイクル全スキップ
CIRCUIT_BREAKER_WINDOW=10
CIRCUIT_BREAKER_LOSSES=5

# ============================================================
# Executor Settings
# ============================================================
# DRY_RUN=true → log only, DRY_RUN=false → live order (future)
DRY_RUN=true

# 固定 SL/TP (USE_ATR_SL=false の場合のフォールバック)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# ============================================================
# Notifications (Discord Webhook)
# ============================================================
# Discord チャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック
# 未設定の場合は通知をスキップ（動作には影響なし）
DISCORD_WEBHOOK_URL=

# ============================================================
# Price Tracking
# ============================================================
# 検出銘柄を何時間追跡するか
TRACKING_HOURS=24

# ============================================================
# Filter Granularity Experiment (シャドウトレード)
# ============================================================
# 現行 STRICT フィルターを通った/外れた問わず、全候補を仮想エントリーとして
# 追跡する。data/experiments.json に蓄積され、tools/analyze_experiments.py が
# data/experiment_report.md を生成する。実トレードには影響しない。
#
# シャドウトレードの追跡時間 (短いほど早く outcome 確定 → 早く統計が貯まる)
EXPERIMENT_TRACKING_HOURS=8
# 1サイクルで新規登録するシャドウトレードの上限 (ファイル肥大化抑制)
EXPERIMENT_MAX_PER_CYCLE=20

# ============================================================
# Fundamental Analysis (無料RSS + Reddit, APIキー不要)
# ============================================================
# CryptoPanic は有料化のため廃止。
# CoinDesk / CoinTelegraph / Decrypt / BeInCrypto の RSS と
# Reddit (r/CryptoCurrency, r/CryptoMoonShots) を無料で使用。

# ニュース検索の遡及時間 (時間)
FUNDAMENTAL_LOOKBACK_HOURS=48

# Reddit 検索を有効にするか (true/false)
USE_REDDIT_NEWS=true

# ============================================================
# Live Trading Filter / Strategy (core/live_filter.py & live_strategy.py)
# ============================================================
# シャドウ集計 (data/experiment_report.md) をもとに実トレードに昇格させる
# Tier S/A/B 判定とポジションサイズを決定する。DRY_RUN=true 中は
# LiveTradePlan を構築するだけで注文は発行されない。

# ─ Tier gating (全 Tier 共通の前提) ─
LIVE_RSI_MIN=70
LIVE_RSI_4H_MAX=65
LIVE_ATR_HIGH=11.0
LIVE_REL_STRENGTH_MIN=5.0
LIVE_REQUIRE_FUND_NON_AVOID=true

# ─ Block (強制却下) ─ 統計的に劣るゾーン
BLOCK_CONSEC_GREEN_1H=8
BLOCK_BBW_LO=15.0
BLOCK_BBW_HI=20.0
BLOCK_MA_DEV_LO=5.0
BLOCK_MA_DEV_HI=10.0
BLOCK_ATR_LO=5.0
BLOCK_ATR_HI=7.0
BLOCK_WICK_RATIO=0.6

# ─ Booster (加点のみ、却下には使わない) ─
BOOST_FUNDING_RATE=0.10

# ─ Risk sizing ─
LIVE_BASE_RISK_PCT=0.5
LIVE_MAX_RISK_PCT=1.5
LIVE_MAX_LEVERAGE=3.0
LIVE_TIER_MULT_S=1.50
LIVE_TIER_MULT_A=1.20
LIVE_TIER_MULT_B=0.80
LIVE_BOOST_MULT=0.40

# ─ Entry styling ─
LIVE_LIMIT_OFFSET_PCT=7.0
LIVE_PATIENT_OFFSET_PCT=6.0
LIVE_SCALE_MARKET_WEIGHT=0.4

# ─ Direction bias (experiment_report セクション22 の short_edge%) ─
LIVE_LONG_BIAS_PCT=60.0
LIVE_SHORT_BIAS_PCT=40.0

# ─ Trailing / partial TP ─
LIVE_MOVE_BE_AT_RR=1.0
LIVE_PARTIAL_TP_RR=1.0
LIVE_PARTIAL_TP_RATIO=0.5

# ─ Live virtual portfolio (core/live_portfolio.py) ─
# ライブ戦略の仮想残高を $100 ベースで追跡。data/live_portfolio.json に保存。
LIVE_VIRTUAL_CAPITAL=100

# ─ Live executor safety (core/executor.py LiveExecutor) ─
# DRY_RUN=false かつ MEXC API キー設定時に有効。
# 残高がこの値を下回ると新規エントリー全停止 (USDT)。
LIVE_MIN_BALANCE_USDT=5.0
# 同時保有可能なポジション数の上限。これを超えると新規エントリー停止。
LIVE_MAX_OPEN_POSITIONS=3

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/scanner.log
